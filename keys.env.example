# HackerToolkit API keys  —  copy to ~/.config/hackertoolkit/keys.env and fill in.
#
#   mkdir -p ~/.config/hackertoolkit
#   cp keys.env.example ~/.config/hackertoolkit/keys.env
#   $EDITOR ~/.config/hackertoolkit/keys.env
#   chmod 600 ~/.config/hackertoolkit/keys.env
#
# install.sh loads this file at the start of a run and wires it into the toolkit
# shell env, so the tools below (and the installer's own GitHub API calls) see
# the keys. Never commit your real keys.env — only this .example file.

# GitHub personal access token (github-search, github-subdomains, gitleaks) —
# also raises the rate limit the installer's release resolver uses.
export GITHUB_TOKEN=""

# Shodan (karma_v2, shosubgo, wtfis, the shodan CLI)
export SHODAN_API_KEY=""

# SecurityTrails (wtfis)
export SECURITYTRAILS_API_KEY=""

# VirusTotal (wtfis)
export VIRUSTOTAL_API_KEY=""

# Censys (karma_v2)
export CENSYS_API_ID=""
export CENSYS_API_SECRET=""
